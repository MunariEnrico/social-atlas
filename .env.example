# SOCIAL ATLAS — environment variables
#
# The MVP needs NO secrets and NO paid API keys. Everything below is optional tuning.
# On GitHub Actions these are set in the workflow; for local runs copy to .env and
# `export $(grep -v '^#' .env | xargs)` before `python -m pipeline.run`.

# Seconds to wait between two requests to the same website (politeness). Default 3.
ATLAS_MIN_DELAY=3

# Label recorded in the run log: schedule | manual | local | submission
ATLAS_TRIGGER=local

# --- Not used by the MVP. Listed so nobody adds them to the frontend by mistake. ---
# Any future key (e.g. a flight API or an optional AI summariser) must be stored as a
# GitHub Actions secret and read only by the pipeline — never put it in site/config.js.
# FLIGHT_API_KEY=
